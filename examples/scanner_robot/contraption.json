{
  "format": "contraption-2",
  "id": "apartment-scanner-robot",
  "name": "Romi orbital 3D-scanning motion prototype",
  "version": "0.2.0",
  "physical_root": {
    "component": "chassis",
    "pose": {
      "translation_m": [0.85, 0.0, 0.0],
      "rotation_quaternion_wxyz": [0.7071067811865476, 0.0, 0.0, 0.7071067811865475]
    },
    "state_binding": {
      "kind": "planar",
      "x": "chassis.position_x",
      "y": "chassis.position_y",
      "yaw": "chassis.yaw"
    }
  },
  "components": [
    {"id": "battery-pack", "package": "scanner.nimh_battery", "parameters": {"open_circuit_voltage": 7.2, "internal_resistance": 0.12}, "condition": "unverified"},
    {"id": "chassis", "package": "scanner.romi_chassis", "parameters": {"mass": 0.16, "yaw_inertia": 0.0006502666666666667, "wheel_base": 0.15, "linear_drag": 1.2, "angular_drag": 0.06}, "condition": "unverified"},
    {"id": "control-board", "package": "scanner.control_board", "parameters": {"logic_voltage": 5.0}, "condition": "unverified"},
    {"id": "left-motor", "package": "scanner.gearmotor", "parameters": {"resistance": 3.6, "effective_inductance": 0.08, "electromechanical_constant": 0.30}, "condition": "unverified"},
    {"id": "right-motor", "package": "scanner.gearmotor", "parameters": {"resistance": 3.6, "effective_inductance": 0.08, "electromechanical_constant": 0.30}, "condition": "unverified"},
    {"id": "left-wheel", "package": "scanner.wheel", "parameters": {"radius": 0.035, "rolling_ratio": 0.9}, "condition": "unverified"},
    {"id": "right-wheel", "package": "scanner.wheel", "parameters": {"radius": 0.035, "rolling_ratio": 0.9}, "condition": "unverified"},
    {"id": "encoder-pair", "package": "scanner.encoder_pair", "parameters": {"equivalent_resistance": 250.0}, "condition": "unverified"},
    {"id": "servo-regulator", "package": "scanner.servo_regulator", "parameters": {"output_voltage": 6.0, "efficiency": 0.88}, "condition": "unverified"},
    {"id": "lift-servo", "package": "scanner.position_servo", "parameters": {"stiffness": 1.1, "damping": 0.08, "efficiency": 0.65}, "condition": "unverified"},
    {"id": "tilt-servo", "package": "scanner.position_servo", "parameters": {"stiffness": 0.8, "damping": 0.06, "efficiency": 0.65}, "condition": "unverified"},
    {"id": "arm-linkage", "package": "scanner.arm_linkage", "parameters": {"inertia": 0.002, "damping": 0.04, "gravity_torque": 0.12}, "condition": "unverified"},
    {"id": "camera", "package": "scanner.camera", "parameters": {"inertia": 0.00008, "bearing_damping": 0.01, "current_draw": 0.15}, "condition": "unverified"},
    {"id": "compute", "package": "scanner.compute", "parameters": {"resistance": 6.25}, "condition": "unverified"},
    {"id": "electrical-reference", "package": "scanner.electrical_reference", "parameters": {}, "condition": "unverified"}
  ],
  "connections": [
    {"id": "mount-battery", "kind": "attachment", "domain": "mechanical", "endpoints": ["chassis.battery_mount", "battery-pack.mount"], "joint": {"kind": "fixed", "behavior_binding": "kinematic_only", "coordinate_bindings": []}},
    {"id": "mount-control-board", "kind": "attachment", "domain": "mechanical", "endpoints": ["chassis.controller_mount", "control-board.mount"], "joint": {"kind": "fixed", "behavior_binding": "kinematic_only", "coordinate_bindings": []}},
    {"id": "mount-left-motor", "kind": "attachment", "domain": "mechanical", "endpoints": ["chassis.left_motor_mount", "left-motor.case_mount"], "joint": {"kind": "fixed", "behavior_binding": "kinematic_only", "coordinate_bindings": []}},
    {"id": "mount-right-motor", "kind": "attachment", "domain": "mechanical", "endpoints": ["chassis.right_motor_mount", "right-motor.case_mount"], "joint": {"kind": "fixed", "behavior_binding": "kinematic_only", "coordinate_bindings": []}},
    {"id": "mount-encoders", "kind": "attachment", "domain": "mechanical", "endpoints": ["chassis.encoder_mount", "encoder-pair.mount"], "joint": {"kind": "fixed", "behavior_binding": "kinematic_only", "coordinate_bindings": []}},
    {"id": "mount-regulator", "kind": "attachment", "domain": "mechanical", "endpoints": ["chassis.regulator_mount", "servo-regulator.mount"], "joint": {"kind": "fixed", "behavior_binding": "kinematic_only", "coordinate_bindings": []}},
    {"id": "mount-lift-servo", "kind": "attachment", "domain": "mechanical", "endpoints": ["chassis.lift_servo_mount", "lift-servo.case_mount"], "joint": {"kind": "fixed", "behavior_binding": "kinematic_only", "coordinate_bindings": []}},
    {"id": "mount-compute", "kind": "attachment", "domain": "mechanical", "endpoints": ["chassis.compute_mount", "compute.mount"], "joint": {"kind": "fixed", "behavior_binding": "kinematic_only", "coordinate_bindings": []}},
    {"id": "left-wheel-joint", "kind": "attachment", "domain": "mechanical", "endpoints": ["left-motor.shaft", "left-wheel.hub"], "joint": {"kind": "revolute", "behavior_binding": "pmdl", "coordinate": "left-wheel.angle", "zero_angle_rad": 0.0, "coordinate_bindings": [{"state": "left-wheel.angle", "joint_angle_at_state_zero_rad": 0.0}]}},
    {"id": "right-wheel-joint", "kind": "attachment", "domain": "mechanical", "endpoints": ["right-motor.shaft", "right-wheel.hub"], "joint": {"kind": "revolute", "behavior_binding": "pmdl", "coordinate": "right-wheel.angle", "zero_angle_rad": 0.0, "coordinate_bindings": [{"state": "right-wheel.angle", "joint_angle_at_state_zero_rad": 0.0}]}},
    {"id": "arm-lift-joint", "kind": "attachment", "domain": "mechanical", "endpoints": ["lift-servo.shaft", "arm-linkage.base"], "joint": {"kind": "revolute", "behavior_binding": "pmdl", "coordinate": "arm-linkage.angle", "zero_angle_rad": 0.0, "coordinate_bindings": [{"state": "arm-linkage.angle", "joint_angle_at_state_zero_rad": 0.0}, {"state": "lift-servo.angle", "joint_angle_at_state_zero_rad": 0.0}]}},
    {"id": "mount-tilt-servo", "kind": "attachment", "domain": "mechanical", "endpoints": ["arm-linkage.tilt_servo_mount", "tilt-servo.case_mount"], "joint": {"kind": "fixed", "behavior_binding": "kinematic_only", "coordinate_bindings": []}},
    {"id": "camera-tilt-joint", "kind": "attachment", "domain": "mechanical", "endpoints": ["tilt-servo.shaft", "camera.mount"], "joint": {"kind": "revolute", "behavior_binding": "pmdl", "coordinate": "camera.angle", "zero_angle_rad": 0.0, "coordinate_bindings": [{"state": "camera.angle", "joint_angle_at_state_zero_rad": 0.0}, {"state": "tilt-servo.angle", "joint_angle_at_state_zero_rad": 0.0}]}},

    {"id": "battery-positive-bus", "kind": "power", "domain": "electrical", "endpoints": ["battery-pack.positive", "control-board.supply_p", "servo-regulator.vin_p"]},
    {"id": "electrical-return-bus", "kind": "power", "domain": "electrical", "endpoints": ["battery-pack.negative", "control-board.supply_n", "control-board.logic_n", "control-board.left_n", "control-board.right_n", "left-motor.n", "right-motor.n", "servo-regulator.vin_n", "servo-regulator.out_n", "lift-servo.supply_n", "tilt-servo.supply_n", "encoder-pair.supply_n", "camera.supply_n", "compute.n", "electrical-reference.ground"]},
    {"id": "logic-positive-bus", "kind": "power", "domain": "electrical", "endpoints": ["control-board.logic_p", "encoder-pair.supply_p", "camera.supply_p", "compute.p"]},
    {"id": "servo-positive-bus", "kind": "power", "domain": "electrical", "endpoints": ["servo-regulator.out_p", "lift-servo.supply_p", "tilt-servo.supply_p"]},
    {"id": "left-motor-positive", "kind": "power", "domain": "electrical", "endpoints": ["control-board.left_p", "left-motor.p"]},
    {"id": "right-motor-positive", "kind": "power", "domain": "electrical", "endpoints": ["control-board.right_p", "right-motor.p"]},
    {"id": "left-floor-contact", "kind": "power", "domain": "mechanical", "endpoints": ["left-wheel.translation", "chassis.left_drive"]},
    {"id": "right-floor-contact", "kind": "power", "domain": "mechanical", "endpoints": ["right-wheel.translation", "chassis.right_drive"]},

    {"id": "left-wheel-sensing", "kind": "signal", "domain": "signal", "endpoints": ["left-wheel.angular_velocity_measurement", "encoder-pair.left_rate"]},
    {"id": "right-wheel-sensing", "kind": "signal", "domain": "signal", "endpoints": ["right-wheel.angular_velocity_measurement", "encoder-pair.right_rate"]},
    {"id": "left-encoder-feedback", "kind": "signal", "domain": "signal", "endpoints": ["encoder-pair.left_measurement", "control-board.left_encoder"]},
    {"id": "right-encoder-feedback", "kind": "signal", "domain": "signal", "endpoints": ["encoder-pair.right_measurement", "control-board.right_encoder"]},
    {"id": "lift-position-feedback", "kind": "signal", "domain": "signal", "endpoints": ["lift-servo.position_measurement", "control-board.lift_position"]},
    {"id": "tilt-position-feedback", "kind": "signal", "domain": "signal", "endpoints": ["tilt-servo.position_measurement", "control-board.tilt_position"]}
  ],
  "controls": [
    {"id": "left-voltage-command", "source": "scanner.left_voltage", "target": "control-board.left_command", "settings": {"unit": "V", "minimum": -4.5, "maximum": 4.5, "default": 0.0, "slew_per_second": 12.0}, "external": false},
    {"id": "right-voltage-command", "source": "scanner.right_voltage", "target": "control-board.right_command", "settings": {"unit": "V", "minimum": -4.5, "maximum": 4.5, "default": 0.0, "slew_per_second": 12.0}, "external": false},
    {"id": "lift-command", "source": "scanner.lift_angle", "target": "lift-servo.position_command", "settings": {"unit": "rad", "minimum": -0.35, "maximum": 0.85, "default": 0.25, "slew_per_second": 1.2}, "external": false},
    {"id": "tilt-command", "source": "scanner.tilt_angle", "target": "tilt-servo.position_command", "settings": {"unit": "rad", "minimum": -0.70, "maximum": 0.70, "default": 0.0, "slew_per_second": 1.2}, "external": false}
  ],
  "controller": {
    "id": "scanner_orbit_controller",
    "version": "1.0.0",
    "sha256": "sha256:dd285ae85c68d06cf0495a2851df29b172a98a269e70cca1dd6aba2e9af568e9",
    "output_bindings": {
      "left_voltage": "scanner.left_voltage",
      "right_voltage": "scanner.right_voltage",
      "lift_target": "scanner.lift_angle",
      "tilt_target": "scanner.tilt_angle"
    },
    "telemetry_outputs": ["record_video"]
  },
  "environment": {
    "gravity_m_s2": [0.0, 0.0, -9.80665],
    "floor": {"kind": "rough-planar", "longitudinal_interaction": {"kind": "component-effective-rolling-ratio", "parameter": "rolling_ratio", "uncertainty": "sampled-per-simulation-run"}, "lateral_slip_simulated": false},
    "object_bounding_cube": {"center_m": [0.0, 0.0, 0.35], "side_m": 0.40},
    "mission": {"orbit_radius_m": 0.85, "tangential_speed_m_s": 0.12, "duration_s": 8.0, "keep_out_radius_m": 0.50}
  },
  "metadata": {
    "coordinate_convention": "right-handed world: x/y floor, +z up; chassis +x forward, +y left",
    "geometry_provenance": "estimated connector locations are explicit in component packages and must be replaced by measured/CAD/scan evidence before construction",
    "optical_physics": false,
    "dynamics_completeness": {
      "schema": "contraption.dynamics-completeness/v1",
      "status": "incomplete",
      "modeled_scope": "bare_chassis_planar_plus_component_local_dynamics",
      "parameter_basis": {
        "component": "chassis",
        "mass_parameter": "mass",
        "mass_scope": "published_bare_chassis_without_batteries",
        "yaw_inertia_parameter": "yaw_inertia",
        "yaw_inertia_estimate": {
          "kind": "uniform_box_about_center_z",
          "package_body": "body",
          "package_solid": "deck",
          "formula": "mass * (length^2 + width^2) / 12",
          "source": "Pololu Romi chassis catalog envelope and published 0.160 kg mass without batteries"
        }
      },
      "gates": [
        {
          "id": "fixed_payload_mass_inertia",
          "status": "open",
          "reason": "Fixed battery, electronics, motor cases, servo cases, and compute payload mass, center of mass, and inertia are not included in planar chassis dynamics."
        },
        {
          "id": "moving_arm_camera_inertial_derivation",
          "status": "open",
          "reason": "Arm and camera inertia and gravity terms are component-local estimates, not derived from downstream body mass properties, parent motion, or configuration."
        },
        {
          "id": "servo_case_reaction_coupling",
          "status": "open",
          "reason": "One-port servo shaft models do not transmit actuator case-reaction torque through their fixed case attachments to the arm or chassis."
        },
        {
          "id": "caster_floor_contact",
          "status": "open",
          "reason": "The physical ball caster and its floor contact, drag, load transfer, and lift constraints are not represented as a component interaction."
        },
        {
          "id": "full_body_keepout",
          "status": "open",
          "reason": "The current keep-out evidence checks only the planar root position; it does not test canonical chassis, arm, camera, or payload solids against the object volume."
        },
        {
          "id": "controller_sensor_observation_binding",
          "status": "open",
          "reason": "Planar localization and speed are ideal simulated-state estimator proxies rather than a hash-bound physical localization and encoder estimator chain."
        },
        {
          "id": "electrical_supply_and_fault_coupling",
          "status": "open",
          "reason": "Actuator and sensor behavior is not supply-voltage-limited, and drive-fault and brownout generation are outside the current component PMDL fidelity."
        }
      ]
    },
    "acceptance": {"orbit_radius_rmse_max_m": 0.12, "camera_pointing_p95_max_deg": 6.0, "root_keepout_violation_probability_max": 0.001},
    "condition": "unverified"
  }
}
