    {"id": "servo-feedback", "kind": "signal", "endpoints": ["lift-servo.position_measurement", "tilt-servo.position_measurement", "control-board.analog_inputs"], "metadata": {"approximately": "1 mV per microsecond command, calibrate individually"}},
