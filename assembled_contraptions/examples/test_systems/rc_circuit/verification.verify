{
  "format": "verification-1",
  "id": "test_system.rc_circuit.physics",
  "name": "RC circuit physics verification",
  "version": "1.1.0",
  "description": "Physics identity checks for the declarative reference-system bundle.",
  "inputs": [
    {
      "name": "voltage",
      "unit": "V",
      "description": "Applied voltage."
    },
    {
      "name": "capacitor_voltage",
      "unit": "V",
      "description": "Capacitor voltage."
    },
    {
      "name": "resistor_current",
      "unit": "A",
      "description": "Resistor current."
    }
  ],
  "parameters": [
    {
      "name": "resistance",
      "unit": "ohm",
      "value": 1000
    },
    {
      "name": "law_tolerance",
      "unit": "A",
      "value": 1e-9
    }
  ],
  "metrics": [
    {
      "name": "ohms_law_rmse",
      "expression": "resistor_current - (voltage - capacitor_voltage) / resistance",
      "reducer": "rmse",
      "unit": "A"
    }
  ],
  "criteria": [
    {
      "name": "ohms_law",
      "expression": "ohms_law_rmse <= law_tolerance",
      "minimum_probability": 0.95,
      "confidence_level": 0.95
    }
  ]
}
