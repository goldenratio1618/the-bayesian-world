{
  "format": "control-1",
  "id": "scanner_orbit_controller",
  "name": "Romi uncertainty-aware orbital scanner controller",
  "version": "2.0.0",
  "period_s": 0.01,
  "explicit_inputs": [
    {"name": "armed", "source": "external", "dtype": "bool", "unit": "1", "default": false, "description": "Mission-enable hardware input."},
    {"name": "reset", "source": "external", "dtype": "bool", "unit": "1", "default": false, "description": "Acknowledge an emergency stop."},
    {"name": "emergency_stop", "source": "external", "dtype": "bool", "unit": "1", "default": false, "description": "Dominant emergency-stop input."},
    {"name": "target_speed", "source": "external", "unit": "m/s", "default": 0.12, "bounds": {"lower": 0.0, "upper": 0.25}, "description": "Requested tangential speed."},
    {"name": "orbit_radius", "source": "external", "unit": "m", "default": 0.85, "bounds": {"lower": 0.65, "upper": 1.5}, "description": "Requested radius about the modeled object center."},
    {"name": "position_x", "source": "sensor", "unit": "m", "default": 0.85, "bounds": {"lower": -10.0, "upper": 10.0}, "measurement_variance": 0.0001, "description": "Wired planar-localization x output."},
    {"name": "position_y", "source": "sensor", "unit": "m", "default": 0.0, "bounds": {"lower": -10.0, "upper": 10.0}, "measurement_variance": 0.0001, "description": "Wired planar-localization y output."},
    {"name": "heading_x", "source": "sensor", "unit": "1", "default": 0.0, "bounds": {"lower": -1.0, "upper": 1.0}, "measurement_variance": 0.0001, "description": "Wired x component of the localization heading vector."},
    {"name": "heading_y", "source": "sensor", "unit": "1", "default": 1.0, "bounds": {"lower": -1.0, "upper": 1.0}, "measurement_variance": 0.0001, "description": "Wired y component of the localization heading vector."},
    {"name": "left_wheel_rate", "source": "sensor", "unit": "rad/s", "default": 0.0, "bounds": {"lower": -30.0, "upper": 30.0}, "measurement_variance": 0.25, "description": "Left encoder angular-rate wire."},
    {"name": "right_wheel_rate", "source": "sensor", "unit": "rad/s", "default": 0.0, "bounds": {"lower": -30.0, "upper": 30.0}, "measurement_variance": 0.25, "description": "Right encoder angular-rate wire."},
    {"name": "lift_feedback", "source": "sensor", "unit": "rad", "default": 0.25, "bounds": {"lower": -0.35, "upper": 0.85}, "measurement_variance": 0.0001, "description": "Lift-servo feedback wire."},
    {"name": "tilt_feedback", "source": "sensor", "unit": "rad", "default": 0.0, "bounds": {"lower": -0.7, "upper": 0.7}, "measurement_variance": 0.0001, "description": "Tilt-servo feedback wire."}
  ],
  "implicit_inputs": [
    {
      "name": "forward_speed",
      "unit": "m/s",
      "initial_variance": 0.01,
      "process_variance_per_s": 0.0025,
      "bounds": {"lower": -1.0, "upper": 1.0}
    }
  ],
  "observer": {
    "kind": "local_affine",
    "nonlinear_approximation": "approved",
    "sample_radius_relative": 0.0001,
    "maximum_sampled_remainder": 0.01,
    "acknowledged_open_gates": [
      "fixed_payload_mass_inertia",
      "moving_arm_camera_inertial_derivation",
      "servo_case_reaction_coupling",
      "caster_floor_contact",
      "full_body_keepout",
      "controller_sensor_observation_binding",
      "electrical_supply_and_fault_coupling"
    ]
  },
  "outputs": [
    {"name": "left_voltage", "unit": "V", "default": 0.0, "bounds": {"lower": -4.5, "upper": 4.5}, "slew_rate": 12.0, "emergency_value": 0.0, "description": "Left motor averaged-voltage command."},
    {"name": "right_voltage", "unit": "V", "default": 0.0, "bounds": {"lower": -4.5, "upper": 4.5}, "slew_rate": 12.0, "emergency_value": 0.0, "description": "Right motor averaged-voltage command."},
    {"name": "lift_target", "unit": "rad", "default": 0.25, "bounds": {"lower": -0.35, "upper": 0.85}, "slew_rate": 1.2, "emergency_value": 0.25, "description": "Lift-servo position command."},
    {"name": "tilt_target", "unit": "rad", "default": 0.0, "bounds": {"lower": -0.7, "upper": 0.7}, "slew_rate": 1.2, "emergency_value": 0.0, "description": "Camera tilt-servo position command."},
    {"name": "record_video", "dtype": "bool", "unit": "1", "default": false, "emergency_value": false, "description": "External camera-recording hardware gate."}
  ],
  "parameters": [
    {"name": "speed_feedforward", "unit": "V*s/m", "default": 12.0, "bounds": {"lower": 0.0, "upper": 40.0}},
    {"name": "speed_kp", "unit": "V*s/m", "default": 4.0, "bounds": {"lower": 0.0, "upper": 30.0}},
    {"name": "heading_kp", "unit": "V", "default": 2.5, "bounds": {"lower": 0.0, "upper": 20.0}},
    {"name": "radius_kp", "unit": "V/m", "default": 1.6, "bounds": {"lower": 0.0, "upper": 20.0}},
    {"name": "voltage_limit", "unit": "V", "default": 4.5, "bounds": {"lower": 0.1, "upper": 12.0}},
    {"name": "speed_uncertainty_scale", "unit": "m/s", "default": 0.05, "bounds": {"lower": 0.001, "upper": 1.0}},
    {"name": "minimum_radius", "unit": "m", "default": 0.1, "bounds": {"lower": 0.01, "upper": 1.0}},
    {"name": "lift_midpoint", "unit": "rad", "default": 0.25, "bounds": {"lower": -0.35, "upper": 0.85}},
    {"name": "lift_amplitude", "unit": "rad", "default": 0.45, "bounds": {"lower": 0.0, "upper": 0.6}},
    {"name": "lift_min", "unit": "rad", "default": -0.35, "bounds": {"lower": -1.2, "upper": 1.2}},
    {"name": "lift_max", "unit": "rad", "default": 0.85, "bounds": {"lower": -1.2, "upper": 1.2}},
    {"name": "tilt_min", "unit": "rad", "default": -0.7, "bounds": {"lower": -1.2, "upper": 1.2}},
    {"name": "tilt_max", "unit": "rad", "default": 0.7, "bounds": {"lower": -1.2, "upper": 1.2}},
    {"name": "object_center_height", "unit": "m", "default": 0.35, "bounds": {"lower": 0.0, "upper": 2.0}},
    {"name": "camera_base_height", "unit": "m", "default": 0.14, "bounds": {"lower": 0.0, "upper": 1.0}},
    {"name": "arm_length", "unit": "m", "default": 0.18, "bounds": {"lower": 0.01, "upper": 1.0}}
  ],
  "derived": [
    {"name": "radius", "unit": "m", "expression": "sqrt(input.position_x ** 2 + input.position_y ** 2)"},
    {"name": "safe_radius", "unit": "m", "expression": "max(derived.radius, parameter.minimum_radius)"},
    {"name": "radius_error", "unit": "m", "expression": "derived.radius - input.orbit_radius"},
    {"name": "tangent_x", "unit": "1", "expression": "-input.position_y / derived.safe_radius"},
    {"name": "tangent_y", "unit": "1", "expression": "input.position_x / derived.safe_radius"},
    {"name": "heading_error", "unit": "1", "expression": "derived.tangent_x * input.heading_y - derived.tangent_y * input.heading_x"},
    {"name": "speed_std", "unit": "m/s", "expression": "sqrt(implicit.forward_speed.variance)"},
    {"name": "speed_confidence", "unit": "1", "expression": "1.0 / (1.0 + derived.speed_std / parameter.speed_uncertainty_scale)"},
    {"name": "drive_base", "unit": "V", "expression": "derived.speed_confidence * (parameter.speed_feedforward * input.target_speed + parameter.speed_kp * (input.target_speed - implicit.forward_speed.mean))"},
    {"name": "steering", "unit": "V", "expression": "parameter.heading_kp * derived.heading_error + parameter.radius_kp * derived.radius_error"},
    {"name": "lift_wave", "unit": "1", "expression": "2.0 * input.position_x * input.position_y / (derived.safe_radius ** 2)"},
    {"name": "lift_command", "unit": "rad", "expression": "parameter.lift_midpoint + parameter.lift_amplitude * derived.lift_wave"},
    {"name": "look_height", "unit": "m", "expression": "parameter.object_center_height - parameter.camera_base_height - parameter.arm_length * input.lift_feedback"},
    {"name": "tilt_command", "unit": "rad", "expression": "derived.look_height / derived.safe_radius - input.lift_feedback"}
  ],
  "modes": [
    {
      "name": "idle",
      "outputs": {
        "left_voltage": "0.0 * parameter.voltage_limit",
        "right_voltage": "0.0 * parameter.voltage_limit",
        "lift_target": "input.lift_feedback",
        "tilt_target": "input.tilt_feedback",
        "record_video": "False"
      },
      "transitions": [
        {"target": "emergency", "guard": "input.emergency_stop", "priority": 100},
        {"target": "scanning", "guard": "input.armed and not input.emergency_stop", "priority": 10}
      ]
    },
    {
      "name": "scanning",
      "outputs": {
        "left_voltage": "clip(derived.drive_base - derived.steering, -parameter.voltage_limit, parameter.voltage_limit)",
        "right_voltage": "clip(derived.drive_base + derived.steering, -parameter.voltage_limit, parameter.voltage_limit)",
        "lift_target": "clip(derived.lift_command, parameter.lift_min, parameter.lift_max)",
        "tilt_target": "clip(derived.tilt_command, parameter.tilt_min, parameter.tilt_max)",
        "record_video": "True"
      },
      "transitions": [
        {"target": "emergency", "guard": "input.emergency_stop", "priority": 100},
        {"target": "idle", "guard": "not input.armed", "priority": 10}
      ]
    },
    {
      "name": "emergency",
      "outputs": {
        "left_voltage": "0.0 * parameter.voltage_limit",
        "right_voltage": "0.0 * parameter.voltage_limit",
        "lift_target": "input.lift_feedback",
        "tilt_target": "input.tilt_feedback",
        "record_video": "False"
      },
      "transitions": [
        {"target": "idle", "guard": "input.reset and not input.emergency_stop", "priority": 10}
      ]
    }
  ],
  "initial_mode": "idle",
  "emergency_when": "input.emergency_stop",
  "metadata": {
    "hardware_math": "Fixed-point-safe algebraic orbit controller; heading and lift harmonics use measured vector components rather than runtime trigonometry.",
    "estimator": "A coupled local-affine observer is derived from the exact PMDL closure and infers chassis.forward_speed from every real sensor wire."
  }
}
