  "metadata": {
    "coordinate_convention": "right-handed world: x/y floor, +z up; chassis +x forward, +y left",
    "geometry_provenance": "Estimated connector locations are explicit in model_catalog static.part records and must be replaced by measured/CAD/scan evidence before construction.",
    "dynamics_completeness": {
      "schema": "contraption.dynamics-completeness/v1",
      "status": "incomplete",
      "modeled_scope": "bare_chassis_planar_plus_component_local_dynamics",
      "parameter_basis": {
        "component": "chassis",
        "mass_parameter": "mass",
        "mass_scope": "published_bare_chassis_without_batteries",
        "yaw_inertia_parameter": "yaw_inertia",
        "yaw_inertia_estimate": {
          "kind": "uniform_box_about_center_z",
          "part_body": "body",
          "part_solid": "deck",
          "formula": "mass * (length^2 + width^2) / 12",
          "source": "Pololu Romi chassis catalog envelope and published 0.160 kg mass without batteries"
        }
      },
      "gates": [
        {
          "id": "fixed_payload_mass_inertia",
          "status": "open",
          "reason": "Fixed battery, electronics, motor cases, servo cases, and compute payload mass, center of mass, and inertia are not included in planar chassis dynamics."
        },
        {
          "id": "moving_arm_camera_inertial_derivation",
          "status": "open",
          "reason": "Arm and camera inertia and gravity terms are component-local estimates, not derived from downstream body mass properties, parent motion, or configuration."
        },
        {
          "id": "servo_case_reaction_coupling",
          "status": "open",
          "reason": "One-port servo shaft models do not transmit actuator case-reaction torque through their fixed case attachments to the arm or chassis."
        },
        {
          "id": "caster_floor_contact",
          "status": "open",
          "reason": "The physical ball caster and its floor contact, drag, load transfer, and lift constraints are not represented as a component interaction."
        },
        {
          "id": "full_body_keepout",
          "status": "open",
          "reason": "The current keep-out evidence checks only the planar root position; it does not test canonical chassis, arm, camera, or payload solids against the object volume."
        },
        {
          "id": "controller_sensor_observation_binding",
          "status": "open",
          "reason": "The controller now uses hash-bound encoder inference and explicit localization wires, but the localization channels are still ideal chassis outputs rather than a qualified physical sensor package."
        },
        {
          "id": "electrical_supply_and_fault_coupling",
          "status": "open",
          "reason": "Actuator and sensor behavior is not supply-voltage-limited, and drive-fault and brownout generation are outside the current component PMDL fidelity."
        }
      ]
    },
    "condition": "unverified"
  }
