{
  "format": "verification-1",
  "id": "scanner.orbit_acceptance",
  "name": "Scanner orbit and camera acceptance",
  "version": "1.1.0",
  "description": "Posterior trajectory criteria for loop coverage, closure, radial tracking, keep-out, and camera pointing.",
  "inputs": [
    {"name": "position_x", "unit": "m", "description": "Chassis planar x state."},
    {"name": "position_y", "unit": "m", "description": "Chassis planar y state."},
    {"name": "camera_angle", "unit": "rad", "description": "Camera revolute angle state."},
    {"name": "lift_angle", "unit": "rad", "description": "Arm lift angle state."}
  ],
  "parameters": [
    {"name": "target_radius", "unit": "m", "value": 0.85},
    {"name": "radius_rmse_limit", "unit": "m", "value": 0.12},
    {"name": "closure_limit", "unit": "m", "value": 0.12},
    {"name": "keepout_radius", "unit": "m", "value": 0.5},
    {"name": "positive_extent", "unit": "m", "value": 0.65},
    {"name": "negative_extent", "unit": "m", "value": -0.65},
    {"name": "object_center_height", "unit": "m", "value": 0.35},
    {"name": "camera_base_height", "unit": "m", "value": 0.14},
    {"name": "pointing_rmse_limit", "unit": "rad", "value": 0.10471975511965977}
  ],
  "metrics": [
    {"name": "initial_x", "expression": "position_x", "reducer": "initial", "unit": "m"},
    {"name": "initial_y", "expression": "position_y", "reducer": "initial", "unit": "m"},
    {"name": "final_x", "expression": "position_x", "reducer": "final", "unit": "m"},
    {"name": "final_y", "expression": "position_y", "reducer": "final", "unit": "m"},
    {"name": "minimum_x", "expression": "position_x", "reducer": "min", "unit": "m"},
    {"name": "maximum_x", "expression": "position_x", "reducer": "max", "unit": "m"},
    {"name": "minimum_y", "expression": "position_y", "reducer": "min", "unit": "m"},
    {"name": "maximum_y", "expression": "position_y", "reducer": "max", "unit": "m"},
    {"name": "minimum_radius", "expression": "sqrt(position_x ** 2 + position_y ** 2)", "reducer": "min", "unit": "m"},
    {"name": "radius_rmse", "expression": "sqrt(position_x ** 2 + position_y ** 2) - target_radius", "reducer": "rmse", "unit": "m"},
    {"name": "pointing_rmse", "expression": "camera_angle + lift_angle - atan2(object_center_height - camera_base_height, sqrt(position_x ** 2 + position_y ** 2))", "reducer": "rmse", "unit": "rad"}
  ],
  "criteria": [
    {
      "name": "loop_closure",
      "expression": "sqrt((final_x - initial_x) ** 2 + (final_y - initial_y) ** 2) <= closure_limit",
      "minimum_probability": 0.95,
      "confidence_level": 0.95,
      "description": "At least 95% posterior probability of returning within the closure radius."
    },
    {
      "name": "full_orbit_extent",
      "expression": "minimum_x <= negative_extent and maximum_x >= positive_extent and minimum_y <= negative_extent and maximum_y >= positive_extent",
      "minimum_probability": 0.95,
      "confidence_level": 0.95,
      "description": "At least 95% posterior probability of covering all four sides of the orbit."
    },
    {
      "name": "radial_tracking",
      "expression": "radius_rmse <= radius_rmse_limit",
      "minimum_probability": 0.95,
      "confidence_level": 0.95
    },
    {
      "name": "root_keepout",
      "expression": "minimum_radius >= keepout_radius",
      "minimum_probability": 0.999,
      "confidence_level": 0.99
    },
    {
      "name": "camera_pointing",
      "expression": "pointing_rmse <= pointing_rmse_limit",
      "minimum_probability": 0.95,
      "confidence_level": 0.95
    }
  ]
}
