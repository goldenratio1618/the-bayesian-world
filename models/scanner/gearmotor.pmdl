{
  "format": "pmdl-1",
  "id": "electromechanical.scanner_gearmotor.lumped",
  "name": "Scanner geared brushed DC motor",
  "version": "1.0.0",
  "domains": ["electromechanical", "electrical", "mechanical"],
  "category": "brushed-dc-motor",
  "description": "A low-bandwidth armature model referred to the scanner wheel shaft.",
  "power_ports": [
    {"name": "p", "domain": "electrical", "effort": "v_p", "flow": "i_p", "effort_unit": "V", "flow_unit": "A", "orientation": "into_component", "frame": "terminal_p", "reference": "positive motor terminal"},
    {"name": "n", "domain": "electrical", "effort": "v_n", "flow": "i_n", "effort_unit": "V", "flow_unit": "A", "orientation": "into_component", "frame": "terminal_n", "reference": "negative motor terminal"},
    {"name": "shaft", "domain": "mechanical", "effort": "torque_shaft", "flow": "omega_shaft", "effort_unit": "N*m", "flow_unit": "rad/s", "orientation": "into_component", "frame": "shaft", "reference": "outboard positive wheel rotation"}
  ],
  "states": [
    {"name": "armature_current", "unit": "A", "initial": 0.0, "derivative": "armature_current_dot", "description": "Effective gearmotor armature current."}
  ],
  "parameters": [
    {"name": "resistance", "unit": "ohm", "default": 3.6, "bounds": {"lower": 0.01, "upper": 100.0}, "uncertainty": {"distribution": "normal", "parameters": {"std": 0.35}}, "learnable": true},
    {"name": "effective_inductance", "unit": "H", "default": 0.08, "bounds": {"lower": 0.000001, "upper": 10.0}, "uncertainty": {"distribution": "lognormal", "parameters": {"std": 0.02}}, "learnable": true},
    {"name": "electromechanical_constant", "unit": "N*m/A", "default": 0.30, "bounds": {"lower": 0.000001, "upper": 100.0}, "uncertainty": {"distribution": "normal", "parameters": {"std": 0.03}}, "learnable": true, "description": "One reciprocal coherent-SI constant shared by shaft torque and back EMF; nonideal gear loss must be modeled separately."}
  ],
  "relations": [
    {"name": "armature_dynamics", "expression": "effective_inductance * armature_current_dot - (v_p - v_n - resistance * armature_current - electromechanical_constant * omega_shaft)"},
    {"name": "positive_terminal_current", "expression": "i_p - armature_current"},
    {"name": "negative_terminal_current", "expression": "i_n + armature_current"},
    {"name": "electromagnetic_torque", "expression": "torque_shaft + electromechanical_constant * armature_current"}
  ],
  "initialization": {"strategy": "consistent", "constraints": [], "required": ["armature_current"]},
  "validity": {"ranges": {"armature_current": {"lower": -3.0, "upper": 3.0}, "omega_shaft": {"lower": -30.0, "upper": 30.0}}, "assumptions": ["Gear train is rigid", "Effective inductance intentionally represents the low-bandwidth scanner fidelity", "Saturation and gear backlash are omitted"], "max_timestep": 0.05},
  "trust": {"structural": "tested", "physical": "reviewed", "numerical": "tested", "empirical": "unverified", "evidence": []},
  "metadata": {"gold": false, "scanner_component": true, "causality": "acausal", "descriptor_form": "F(t,z,zdot,theta,u)=0", "online_admission": {"admitted": true, "kind": "linear"}}
}
